generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeAnnonce {
  offre
  besoin
}

enum Categorie {
  vetement
  denree
  enfant
  autre
}

enum StatutAnnonce {
  ouverte
  reservee
  fermee
}

enum StatutEchange {
  ouvert
  remis
  annule
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  annonces        Annonce[]
  reponses        Reponse[]
  echangesOfferts Echange[] @relation("Offrant")
  echangesRecus   Echange[] @relation("Demandeur")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Annonce {
  id        String        @id @default(cuid())
  type      TypeAnnonce
  titre     String
  categorie Categorie
  detail    String        @default("")
  photoUrl  String?
  statut    StatutAnnonce @default(ouverte)
  auteurId  String?
  auteur    User?         @relation(fields: [auteurId], references: [id])
  reponses  Reponse[]
  echange   Echange?
  createdAt DateTime      @default(now())
}

model Reponse {
  id        String   @id @default(cuid())
  annonceId String
  auteurId  String
  annonce   Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  auteur    User     @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([annonceId, auteurId])
}

model Echange {
  id          String        @id @default(cuid())
  jeton       String        @unique
  annonceId   String        @unique
  offrantId   String
  demandeurId String
  statut      StatutEchange @default(ouvert)
  annonce     Annonce       @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  offrant     User          @relation("Offrant", fields: [offrantId], references: [id])
  demandeur   User          @relation("Demandeur", fields: [demandeurId], references: [id])
  createdAt   DateTime      @default(now())
}
