generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeAnnonce {
  offre
  besoin
}

enum Categorie {
  vetement
  denree
  enfant
  autre
}

enum StatutAnnonce {
  ouverte
  reservee
  fermee
}

model Annonce {
  id        String         @id @default(cuid())
  type      TypeAnnonce
  titre     String
  categorie Categorie
  detail    String         @default("")
  statut    StatutAnnonce  @default(ouverte)
  createdAt DateTime       @default(now())
}
